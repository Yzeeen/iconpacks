<Window x:Class="DesktopIconChanger.FluentIconBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:common="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
        mc:Ignorable="d"
        Title="Fluent 图标库（内置 2933 个图标）" Height="680" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：搜索 + 变体 + 尺寸 -->
        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索 -->
                <TextBox x:Name="txtSearch" Grid.Column="0" Height="32" Margin="0,0,10,0"
                         TextChanged="TxtSearch_TextChanged"
                         VerticalContentAlignment="Center" FontSize="14"
                         Padding="8,0" BorderThickness="1" BorderBrush="#DDD"/>

                <!-- 变体 -->
                <TextBlock Grid.Column="1" Text="变体" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                <ComboBox x:Name="cmbVariant" Grid.Column="2" Width="100" Height="32" Margin="0,0,12,0"
                          SelectionChanged="CmbVariant_SelectionChanged">
                    <ComboBoxItem Content="Regular (细线)"/>
                    <ComboBoxItem Content="Filled (实心)" IsSelected="True"/>
                    <ComboBoxItem Content="Light (细边)"/>
                </ComboBox>

                <!-- 预览尺寸 -->
                <TextBlock Grid.Column="3" Text="尺寸" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666"/>
                <ComboBox x:Name="cmbSize" Grid.Column="4" Width="70" Height="32" SelectionChanged="CmbSize_SelectionChanged">
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="32" IsSelected="True"/>
                    <ComboBoxItem Content="40"/>
                    <ComboBoxItem Content="48"/>
                    <ComboBoxItem Content="64"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 中部：图标网格 -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Background="White">
            <ScrollViewer x:Name="svIcons" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="icIcons" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="72" Height="72" Margin="4" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                                    Cursor="Hand" MouseLeftButtonDown="IconItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E8F0FE"/>
                                                <Setter Property="BorderBrush" Value="#4285F4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ic:FluentIcon Icon="{Binding Icon}" IconVariant="{Binding Variant}"
                                                   Foreground="{Binding Foreground}"
                                                   FontSize="{Binding FontSize}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#888"
                                               HorizontalAlignment="Center" MaxWidth="66"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部：预览 + 按钮 -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1,1,1,0" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 当前选中预览 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8"
                            Width="64" Height="64">
                        <ic:FluentIcon x:Name="icPreview" Icon="Add" IconVariant="Filled" Foreground="#2196F3"
                                       FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="txtSelectedName" Text="（未选中）" FontWeight="Bold"/>
                        <TextBlock x:Name="txtSelectedVariant" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- 按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnOk" Width="110" Height="34" Margin="0,0,8,0"
                            Content="使用此图标" IsEnabled="False"
                            Click="BtnOk_Click" Background="#2196F3" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Width="90" Height="34" Content="取消" Click="BtnCancel_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
