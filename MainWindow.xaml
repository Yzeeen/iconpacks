<Window x:Class="DesktopIconChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopIconChanger"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:beh="clr-namespace:DesktopIconChanger.Behaviors"
        mc:Ignorable="d"
        Title="桌面图标替换工具" Height="720" Width="1180"
        Background="{DynamicResource BgWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- FluentIcon 按钮内嵌默认样式：16px、Regular、跟随父控件 Foreground -->
        <Style x:Key="BtnFluentIcon" TargetType="ic:FluentIcon">
            <Setter Property="IconVariant" Value="Regular"/>
            <Setter Property="IconSize" Value="Size16"/>
        </Style>

        <!-- 图标库侧边栏图标单元格悬停/选中 -->
        <Style x:Key="FluentIconCell" TargetType="Border">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 「已自定义 / 默认」状态文字 -->
        <Style x:Key="ShellStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="默认"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                    <Setter Property="Text" Value="已自定义"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentSuccess}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource BgToolbar}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnScan" Width="110" Height="34" Margin="0,0,8,0"
                        Click="BtnScan_Click" Background="{DynamicResource AccentSuccess}" Foreground="{DynamicResource FgOnAccent}" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ic:FluentIcon Icon="ArrowSync" Style="{StaticResource BtnFluentIcon}" Foreground="{DynamicResource FgOnAccent}"/>
                        <TextBlock x:Name="txtScanButton" Text=" 扫描桌面" VerticalAlignment="Center" Foreground="{DynamicResource FgOnAccent}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Width="90" Height="34" Margin="0,0,8,0"
                        Click="BtnSelectAll_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ic:FluentIcon Icon="CheckboxChecked" Style="{StaticResource BtnFluentIcon}"/>
                        <TextBlock Text=" 全选" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 切换图标库侧边栏 -->
                <Button Grid.Column="3" x:Name="btnToggleFluentSidebar" Width="150" Height="34" Margin="0,0,8,0"
                        Click="BtnToggleFluentSidebar_Click"
                        Background="{DynamicResource AccentPurple}" Foreground="{DynamicResource FgOnAccent}"
                        BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ic:FluentIcon Icon="Sparkle" Style="{StaticResource BtnFluentIcon}" Foreground="{DynamicResource FgOnAccent}"/>
                        <TextBlock x:Name="txtToggleSidebar" Text=" 图标库" VerticalAlignment="Center" Foreground="{DynamicResource FgOnAccent}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="btnChooseIcon" Width="130" Height="34" Margin="0,0,8,0"
                            Click="BtnChooseIcon_Click" Background="{DynamicResource AccentBlue}" Foreground="{DynamicResource FgOnAccent}" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ic:FluentIcon Icon="FolderOpen" Style="{StaticResource BtnFluentIcon}" Foreground="{DynamicResource FgOnAccent}"/>
                            <TextBlock Text=" 选择图标" VerticalAlignment="Center" Foreground="{DynamicResource FgOnAccent}"/>
                        </StackPanel>
                    </Button>
                    <Button Width="110" Height="34" Margin="0,0,8,0"
                            Click="BtnApply_Click" Background="{DynamicResource AccentOrange}" Foreground="{DynamicResource FgOnAccent}" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ic:FluentIcon Icon="CheckmarkCircle" IconVariant="Filled" Foreground="{DynamicResource FgOnAccent}" Style="{StaticResource BtnFluentIcon}"/>
                            <TextBlock Text=" 应用替换" VerticalAlignment="Center" Foreground="{DynamicResource FgOnAccent}"/>
                        </StackPanel>
                    </Button>
                    <Button Width="110" Height="34" Margin="0,0,8,0"
                            Click="BtnRefreshCache_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ic:FluentIcon Icon="Wrench" Style="{StaticResource BtnFluentIcon}"/>
                            <TextBlock Text=" 刷新缓存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="110" Height="34"
                            Click="BtnHistory_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ic:FluentIcon Icon="History" IconVariant="Regular" IconSize="Size16"/>
                            <TextBlock Text=" 历史记录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主区域：三列 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 侧边栏：默认隐藏（Width=0），展开时=380 -->
                <ColumnDefinition x:Name="colFluentSidebar" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ======== 左侧：图标库侧边栏 ======== -->
            <Border Grid.Column="0" x:Name="brdFluentSidebar"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,1,0"
                    Padding="10,8" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 + 关闭 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ic:FluentIcon Icon="Sparkle" IconVariant="Regular" IconSize="Size20"
                                       Foreground="{DynamicResource AccentPurple}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtSidebarTitle" Text=" 图标库" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button x:Name="btnCloseSidebar" Width="26" Height="26" Margin="6,0,0,0"
                                HorizontalAlignment="Right" Click="BtnCloseSidebar_Click" BorderThickness="0" Padding="0"
                                ToolTip="关闭">
                            <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16"/>
                        </Button>
                    </StackPanel>

                    <!-- 搜索 -->
                    <TextBox x:Name="txtFluentSearch" Grid.Row="1" Height="28" Margin="0,0,0,6"
                             TextChanged="TxtFluentSearch_TextChanged"
                             VerticalContentAlignment="Center" FontSize="12" Padding="8,0"/>

                    <!-- 图标库选择 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="图标库：" FontSize="11" Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbIconLibrary" Width="180" Height="26" FontSize="11"
                                  SelectionChanged="CmbIconLibrary_SelectionChanged"/>
                    </StackPanel>

                    <!-- 变体（仅 Fluent 有效） -->
                    <StackPanel x:Name="pnlVariant" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="变体：" FontSize="11" Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbVariantRegular" Content="Regular" IsChecked="True" Margin="6,0,6,0"
                                     Checked="RbVariant_Changed" FontSize="11"/>
                        <RadioButton x:Name="rbVariantFilled" Content="Filled" Margin="0,0,6,0"
                                     Checked="RbVariant_Changed" FontSize="11"/>
                        <RadioButton x:Name="rbVariantLight" Content="Light" Margin="0,0,4,0"
                                     Checked="RbVariant_Changed" FontSize="11"/>
                        <TextBlock x:Name="txtFluentCount" FontSize="10" Foreground="{DynamicResource FgMuted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 线条颜色 -->
                    <Border Grid.Row="4" Background="{DynamicResource BgPanelAlt}" BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="线条颜色：" FontSize="11" Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
                                <RadioButton x:Name="rbColorOriginal" Content="保持原色" FontSize="11" GroupName="LineColorMode"
                                             Margin="4,0,4,0" Checked="LineColorMode_Changed"/>
                                <RadioButton x:Name="rbColorTheme" Content="跟随主题" FontSize="11" GroupName="LineColorMode"
                                             Margin="0,0,4,0" Checked="LineColorMode_Changed"/>
                                <RadioButton x:Name="rbColorCustom" Content="自定义" FontSize="11" GroupName="LineColorMode"
                                             Checked="LineColorMode_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Tag="#000000" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#000000" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#000000" Click="ColorSwatch_Click"/>
                                <Button Tag="#FFFFFF" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#FFFFFF" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#FFFFFF" Click="ColorSwatch_Click"/>
                                <Button Tag="#4CAF50" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#4CAF50" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#4CAF50" Click="ColorSwatch_Click"/>
                                <Button Tag="#2196F3" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#2196F3" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#2196F3" Click="ColorSwatch_Click"/>
                                <Button Tag="#7C4DFF" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#7C4DFF" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#7C4DFF" Click="ColorSwatch_Click"/>
                                <Button Tag="#FF9800" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#FF9800" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#FF9800" Click="ColorSwatch_Click"/>
                                <Button Tag="#F44336" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#F44336" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#F44336" Click="ColorSwatch_Click"/>
                                <Button Tag="#12A594" Width="20" Height="20" Margin="0,0,4,0" Padding="0" Cursor="Hand"
                                        Background="#12A594" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                        ToolTip="#12A594" Click="ColorSwatch_Click"/>
                                <TextBox x:Name="txtCustomHex" Width="76" Height="22" FontSize="11" Margin="6,0,0,0"
                                         VerticalContentAlignment="Center" Padding="4,0"
                                         KeyDown="TxtCustomHex_KeyDown" LostFocus="TxtCustomHex_LostFocus"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 图标网格（分段加载） -->
                    <Border Grid.Row="5" Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="svFluentIcons" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          beh:SmoothScrollBehavior.Enable="True"
                                          beh:SmoothScrollBehavior.Duration="200"
                                          beh:SmoothScrollBehavior.PixelPerDelta="36"
                                          ScrollChanged="SvFluentIcons_ScrollChanged">
                            <ItemsControl x:Name="icFluentIcons" Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FluentIconCell}"
                                                MouseLeftButtonDown="IconItem_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ic:FluentIcon Icon="{Binding FluentIcon}" IconVariant="{Binding Variant}"
                                                               Foreground="{Binding Foreground}" FontSize="22"
                                                               Visibility="{Binding FluentVisibility}"/>
                                                <Image Source="{Binding Thumb}" Width="24" Height="24" Stretch="Uniform"
                                                       Visibility="{Binding ImageVisibility}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="8"
                                                           Foreground="{DynamicResource FgMuted}"
                                                           HorizontalAlignment="Center" MaxWidth="60"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 加载更多指示 -->
                    <TextBlock x:Name="txtFluentMoreStatus" Grid.Row="6" Text="" FontSize="10"
                               Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- 底部预览 + 使用按钮 -->
                    <Border Grid.Row="7" Background="{DynamicResource BgPanelAlt}" CornerRadius="4" Padding="8"
                            Margin="0,6,0,0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BgWindow}"
                                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="4"
                                        Padding="4" Width="48" Height="48">
                                    <Grid>
                                        <ic:FluentIcon x:Name="icSidebarPreview" Icon="Add" IconVariant="Filled"
                                                       Foreground="{DynamicResource AccentPurple}"
                                                       FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="imgSidebarPreview" Width="34" Height="34" Stretch="Uniform"
                                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtSidebarSelName" Text="（未选择）" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="txtSidebarSelVariant" Foreground="{DynamicResource FgMuted}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="btnUseFluentIcon" Grid.Column="2" Width="100" Height="32" Margin="0,0,0,4"
                                    Content="应用此图标" IsEnabled="False" Click="BtnUseFluentIcon_Click"
                                    Background="{DynamicResource AccentPurple}" Foreground="{DynamicResource FgOnAccent}"
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ======== 中间：目标列表（三视图） ======== -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 视图切换 -->
                    <Border Grid.Row="0" Background="{DynamicResource BgPanelAlt}" Padding="10,8"
                            BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbViewDesktop" Content="桌面图标" GroupName="TargetView" IsChecked="True"
                                         Checked="TargetView_Changed" FontSize="12" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbViewSystem" Content="系统图标" GroupName="TargetView"
                                         Checked="TargetView_Changed" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbViewFileType" Content="文件类型" GroupName="TargetView"
                                         Checked="TargetView_Changed" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbViewSettings" Content="设置" GroupName="TargetView"
                                         Checked="TargetView_Changed" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtViewHint" FontSize="10" Foreground="{DynamicResource FgMuted}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 视图 1：桌面图标 -->
                    <DockPanel x:Name="pnlDesktopView" Grid.Row="1">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAlt}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkHeaderSelectAll" Grid.Column="0"
                                          Checked="ChkHeaderSelectAll_Changed" Unchecked="ChkHeaderSelectAll_Changed"/>
                                <TextBlock Grid.Column="1" Text="文件名" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="类型" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="lvIcons" Margin="0,0,0,0"
                                  SelectionMode="Extended"
                                  beh:SmoothScrollBehavior.Enable="True"
                                  beh:SmoothScrollBehavior.Duration="220"
                                  beh:SmoothScrollBehavior.PixelPerDelta="40"
                                  SelectionChanged="LvIcons_SelectionChanged"
                                  MouseDoubleClick="LvIcons_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,5"/>
                                        <Image Grid.Column="1" Source="{Binding PreviewIcon}" Width="32" Height="32" Margin="5,0,10,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{DynamicResource FgSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding IconTypeDescription}" Foreground="{DynamicResource FgSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding Extension}" Foreground="{DynamicResource FgMuted}" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <!-- 视图 2：系统图标 -->
                    <DockPanel x:Name="pnlSystemView" Grid.Row="1" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAlt}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="选择要替换的系统图标" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="恢复默认" Width="90" Height="26" Cursor="Hand"
                                        Click="BtnRestoreShell_Click"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="lvSystemIcons" SelectionChanged="ShellTarget_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding PreviewIcon}" Width="32" Height="32"
                                               Margin="4,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource ShellStateText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <!-- 视图 3：文件类型 -->
                    <DockPanel x:Name="pnlFileTypeView" Grid.Row="1" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAlt}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="扩展名：" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="txtFileExtension" Width="90" Height="26" FontSize="12"
                                         VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                                         KeyDown="TxtFileExtension_KeyDown"/>
                                <Button Grid.Column="2" Content="添加" Width="60" Height="26" Cursor="Hand"
                                        Click="BtnAddFileType_Click"/>
                                <TextBlock Grid.Column="3" Text="应用时以输入框中的扩展名为准"
                                           FontSize="10" Foreground="{DynamicResource FgMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="4" x:Name="txtFileTypeHint" FontSize="11" Margin="10,0,10,0"
                                           Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" Text=""/>
                                <Button Grid.Column="5" Content="恢复默认" Width="90" Height="26" Cursor="Hand"
                                        Click="BtnRestoreShell_Click"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="lvFileTypeIcons" SelectionChanged="ShellTarget_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding PreviewIcon}" Width="32" Height="32"
                                               Margin="4,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Extension}" Foreground="{DynamicResource FgMuted}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource ShellStateText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <!-- 视图 4：设置 -->
                    <DockPanel x:Name="pnlSettingsView" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <TextBlock Text="可选图标库" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="除 Microsoft Fluent 外，其余图标库需下载后启用；安装包保存在 %APPDATA%\DesktopIconChanger\IconPacks。下载来源为 GitHub Releases。"
                                           FontSize="11" Foreground="{DynamicResource FgMuted}"
                                           TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <ItemsControl x:Name="icIconPacks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgPanel}"
                                                    BorderBrush="{DynamicResource BorderDefault}"
                                                    BorderThickness="1" CornerRadius="5"
                                                    Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                              IsChecked="{Binding PackEnabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              Checked="ChkPackEnabled_Changed"
                                                              Unchecked="ChkPackEnabled_Changed"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FgError}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100"
                                                                     Value="{Binding ProgressPercent}" Foreground="{DynamicResource AccentBlue}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="许可协议" Width="76" Height="28" Margin="10,0,8,0"
                                                            Cursor="Hand" Click="BtnPackLicense_Click"/>
                                                    <Button Grid.Column="3" Content="下载" Width="64" Height="28" Margin="0,0,8,0"
                                                            Cursor="Hand" IsEnabled="{Binding CanDownload}" Click="BtnPackDownload_Click"/>
                                                    <Button Grid.Column="4" Content="删除" Width="64" Height="28"
                                                            Cursor="Hand" IsEnabled="{Binding CanRemove}" Click="BtnPackRemove_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="已替换图标" FontWeight="Bold" FontSize="13" Margin="0,10,0,0"/>
                                <TextBlock Text="对已被本工具替换过的 Fluent 图标一键互换 Filled（填充）与 Regular（描边）形态；其余图标库与 Light 变体没有此区分，不参与切换。"
                                           FontSize="11" Foreground="{DynamicResource FgMuted}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>

                                <Border Background="{DynamicResource BgPanel}"
                                        BorderBrush="{DynamicResource BorderDefault}"
                                        BorderThickness="1" CornerRadius="5" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Fill / Regular 形态" FontWeight="Medium"/>
                                            <TextBlock x:Name="txtVariantToggleHint" Text="正在统计…" FontSize="11"
                                                       Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="btnToggleVariant" Content="一键切换"
                                                MinWidth="88" Height="28" Margin="10,0,0,0" Cursor="Hand"
                                                Click="BtnToggleVariant_Click"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="资源管理器外观" FontWeight="Bold" FontSize="13" Margin="0,18,0,0"/>
                                <TextBlock Text="通过 Shell Icons 覆盖项调整资源管理器的显示效果（同时写入当前用户与系统范围），可随时恢复。修改后需要重启资源管理器才能看到效果。"
                                           FontSize="11" Foreground="{DynamicResource FgMuted}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>

                                <Border Background="{DynamicResource BgPanel}"
                                        BorderBrush="{DynamicResource BorderDefault}"
                                        BorderThickness="1" CornerRadius="5" Padding="12,10">
                                    <StackPanel>
                                        <CheckBox x:Name="chkHideShortcutArrow" Content="隐藏快捷方式左下角的小箭头"
                                                  Cursor="Hand"
                                                  Checked="ChkHideShortcutArrow_Changed"
                                                  Unchecked="ChkHideShortcutArrow_Changed"/>
                                        <TextBlock x:Name="txtShortcutArrowHint" Text="当前：系统默认" FontSize="11"
                                                   Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ======== 右侧：预览面板 ======== -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="5" Padding="15">
                <DockPanel>
                    <!-- 当前状态预览 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ic:FluentIcon Icon="Note" IconVariant="Regular" IconSize="Size20" Foreground="{DynamicResource FgLight}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="当前图标状态" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderPanel}" BorderThickness="1"
                            CornerRadius="5" Padding="15" Margin="0,0,0,12" MinHeight="150">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 图标并列展示区 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image x:Name="imgTargetIcon" Width="64" Height="64" HorizontalAlignment="Center"/>
                                    <TextBlock Text="目标原图标" FontSize="10" Foreground="{DynamicResource FgLight}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource FgMuted}" Margin="8,0"/>
                                <StackPanel HorizontalAlignment="Center">
                                    <Image x:Name="imgPreview" Width="64" Height="64" HorizontalAlignment="Center"/>
                                    <TextBlock Text="当前显示" FontSize="10" Foreground="{DynamicResource FgLight}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 图标溯源描述 -->
                            <TextBlock Grid.Row="1" x:Name="txtPreviewSource"
                                       Text="请选择一项以查看图标来源"
                                       Foreground="{DynamicResource AccentBlue}" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <!-- 选中项名称 + 路径 -->
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtPreviewName" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                                <TextBlock x:Name="txtPreviewPath" Foreground="{DynamicResource FgMuted}" FontSize="10" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="260"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 替换后预览 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ic:FluentIcon Icon="Sparkle" IconVariant="Regular" IconSize="Size20" Foreground="{DynamicResource FgLight}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="替换后预览" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgPreviewReplace}" BorderBrush="{DynamicResource BorderPreviewReplace}" BorderThickness="1"
                            CornerRadius="5" Padding="15" Margin="0,0,0,15" Height="120">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="imgReplacePreview" Width="64" Height="64" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtReplaceHint" TextAlignment="Center" Margin="0,5,0,0"
                                       Foreground="{DynamicResource FgSecondary}" FontSize="11" Text="（选择图标后显示）"/>
                        </StackPanel>
                    </Border>

                    <!-- 替换操作 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size20" Foreground="{DynamicResource FgLight}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="替换图标" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="当前选定的图标文件：" Foreground="{DynamicResource FgSecondary}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNewIconPath" IsReadOnly="True" Height="30" Margin="0,0,0,8"/>

                        <Button Height="30" Margin="0,0,0,12" Click="BtnChooseIcon_Click" Cursor="Hand" Width="110">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="FolderOpen" Style="{StaticResource BtnFluentIcon}"/>
                                <TextBlock Text=" 浏览" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,5,0,15"/>

                        <TextBlock x:Name="txtStatus" Text="就绪" Foreground="{DynamicResource AccentSuccess}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelAlt}" CornerRadius="5" Padding="10,5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtItemCount" Grid.Column="0" Text="共 0 项" Foreground="{DynamicResource FgSecondary}"/>
                <TextBlock x:Name="txtSelectedCount" Grid.Column="1" Text="已选择 0 项" Foreground="{DynamicResource AccentBlue}"/>
            </Grid>
        </Border>

        <!-- ============ 右上角轻量提示条 ============
             非模态通知：不遮挡操作、不拦截输入，展示约 5 秒后自动淡出。 -->
        <Border x:Name="brdNotify" Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,2,2,0" Padding="14,9"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                CornerRadius="5" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ttNotify" Y="-8"/>
            </Border.RenderTransform>
            <TextBlock x:Name="txtNotify" FontSize="12"
                       Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>